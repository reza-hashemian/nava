    out property <string> star: "M12 3.8l2.5 5.1 5.6.8-4.05 3.95.96 5.6L12 16.6l-5 2.65.96-5.6L3.9 9.7l5.6-.8z";
    out property <string> send: "M20.5 4L3.6 10.6c-.7.3-.7 1.2 0 1.5l4.4 1.6 1.7 5.3c.2.7 1.1.9 1.6.3l2.5-2.8 4.3 3.2c.6.4 1.4.1 1.5-.6L21.6 5c.1-.7-.5-1.2-1.1-1z M8 13.7l8.9-6.2";
    out property <string> loop: "M7 7h10a3 3 0 0 1 3 3v1 M17 17H7a3 3 0 0 1-3-3v-1 M14.5 4.5L17 7l-2.5 2.5 M9.5 19.5L7 17l2.5-2.5";
}

export component Icon inherits Path {
    in property <string> icon;
    in property <bool> solid: false;
    in property <color> tint: Theme.fg;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: icon;
    fill: solid ? tint : transparent;
    stroke: solid ? transparent : tint;
    // No stroke at all on solid icons: some renderers draw a "transparent"
    // stroke anyway, which fattens the shapes and closes the gaps (‖ ⏮).
    stroke-width: solid ? 0px : 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> solid: false;
    in property <bool> active: false;
    in property <length> size: 34px;
    in property <length> icon-size: 18px;
    in property <color> tint: active ? Theme.accent : Theme.fg;
    in property <string> badge: "";
    // The row underneath loses its hover when the pointer reaches the button.
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    background: ta.pressed ? Theme.hover.darker(0.2) : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; }

    Icon {
        icon: root.icon;
        solid: root.solid;
        tint: root.tint;
        width: ta.pressed ? root.icon-size * 0.88 : root.icon-size;
        height: self.width;
        animate width { duration: 120ms; easing: ease-out; }
    }
    if root.badge != "": Rectangle {
        x: root.width - 13px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        Text {
            text: root.badge;
            color: Theme.on-accent;
            font-size: 8px;
            font-weight: 700;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The big round play / pause button.
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    callback clicked();
    width: 62px;
    height: 62px;
    border-radius: self.width / 2;
    background: ta.pressed ? Theme.fg.darker(0.15) : Theme.fg;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #000000.with-alpha(Theme.dark ? 0.45 : 0.18);
    Icon {
        icon: root.playing ? Icons.pause : Icons.play;
        solid: true;
        tint: Theme.base;
        width: ta.pressed ? 22px : 26px;
        height: self.width;
        animate width { duration: 160ms; easing: ease-out-back; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A thin track that thickens on hover, like the scrubber in Music.app.
export component NSlider inherits Rectangle {
    in property <float> value; // 0..1
    in property <color> fill-color: Theme.fg.with-alpha(0.9);
    in property <length> rest-thickness: 5px;
    in property <color> track-color: Theme.fg.with-alpha(0.16);
    out property <bool> dragging: ta.pressed;
    out property <float> shown: ta.pressed ? drag-value : Math.clamp(value, 0, 1);
    callback moved(float);
    callback released(float);
    property <float> drag-value;
    property <bool> active: ta.has-hover || ta.pressed;
    height: 20px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.active ? root.rest-thickness + 4px : root.rest-thickness;
        border-radius: self.height / 2;
        background: root.track-color;
        clip: true;
        animate height { duration: 180ms; easing: ease-out; }
        // Its own rounded ends: the software renderer doesn't clip to the track's curve.
        Rectangle {
            x: 0;
            width: root.shown <= 0 ? 0 : Math.max(parent.height, parent.width * root.shown);
            height: 100%;
            border-radius: parent.height / 2;
            background: root.fill-color;
        }
    }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        x: root.width * root.shown - 7px;
        y: (root.height - 14px) / 2;
        background: #ffffff;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000055;
        opacity: root.active ? 1 : 0;
        animate opacity { duration: 160ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.drag-value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.moved(root.drag-value);
            } else if e.kind == PointerEventKind.up {
                root.released(root.drag-value);
            }
        }
        moved => {
            if self.pressed {
                root.drag-value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.moved(root.drag-value);
            }
        }
        scroll-event(e) => {
            root.released(Math.clamp(root.value + (e.delta-y > 0 ? 0.04 : -0.04), 0, 1));
            accept
        }
    }
}

// A vertical slider for one equalizer band, -12..+12 dB.
export component BandSlider inherits Rectangle {
    in property <float> gain; // dB
    in property <bool> enabled: true;
    callback changed(float);
    property <float> drag;
    property <float> shown: ta.pressed ? drag : gain;
    property <float> frac: (shown + 12) / 24;
    width: 28px;
    // track
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 5px;
        border-radius: 2.5px;
        background: Theme.fg.with-alpha(0.14);
    }
    // fill from the middle line
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 5px;
        border-radius: 2.5px;
        y: root.frac > 0.5 ? root.height * (1 - root.frac) : root.height / 2;
        height: Math.abs(root.frac - 0.5) * root.height;
        background: root.enabled ? Theme.accent : Theme.muted;
    }
    Rectangle {
        y: root.height / 2;
        x: 6px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.fg.with-alpha(0.2);
    }
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        x: (parent.width - self.width) / 2;
        y: root.height * (1 - root.frac) - 9px;
        background: #ffffff;
        drop-shadow-blur: 5px;
        drop-shadow-color: #00000050;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.drag = Math.round((0.5 - self.mouse-y / root.height) * 24 * 2) / 2;
                root.drag = Math.clamp(root.drag, -12, 12);
                root.changed(root.drag);
            }
        }
        moved => {
            if self.pressed {
                root.drag = Math.clamp(Math.round((0.5 - self.mouse-y / root.height) * 24 * 2) / 2, -12, 12);
                root.changed(root.drag);
            }
        }
        double-clicked => { root.changed(0); }
    }
}

// A row of choices with a pill that slides to the selected one.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback changed(int);
    height: 32px;
    border-radius: 9px;
    background: Theme.faint;
    property <length> cell: (self.width - 6px) / Math.max(1, items.length);

    Rectangle {
        x: 3px + root.cell * root.selected;
        y: 3px;
        width: root.cell;
        height: parent.height - 6px;
        border-radius: 7px;
        background: Theme.dark ? #ffffff.with-alpha(0.16) : #ffffff;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000022;
        animate x { duration: 260ms; easing: cubic-bezier(0.3, 1.3, 0.5, 1); }
    }
    for item[i] in root.items: Rectangle {
        x: 3px + root.cell * i;
        width: root.cell;
        height: root.height;
        Text {
            text: item;
            color: i == root.selected ? Theme.fg : Theme.muted;
            font-size: 13px;
            font-weight: i == root.selected ? 600 : 500;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected = i;
                root.changed(i);
            }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 42px;
    height: 25px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.fg.with-alpha(0.18);
    animate background { duration: 200ms; }
    Rectangle {
        width: 21px;
        height: 21px;
        y: 2px;
        x: root.on ? root.width - self.width - 2px : 2px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
        animate x { duration: 260ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    callback clicked();
    height: 38px;
    min-width: 110px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            icon: root.icon;
            tint: Theme.on-accent;
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.on-accent;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 38px;
    min-width: 96px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: ta.pressed ? Theme.hover.darker(0.2) : ta.has-hover ? Theme.hover : Theme.faint;
    animate background { duration: 140ms; }
    Text {
        text: root.text;
        color: Theme.fg;
        font-size: 14px;
        font-weight: 500;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The three macOS window buttons. Glyphs appear when you hover the group.
export component TrafficLights inherits Rectangle {
    callback close();
    callback minimize();
    callback zoom();
    width: 56px;
    height: 14px;
    property <bool> show-glyphs: ta.has-hover;
    ta := TouchArea {
        HorizontalLayout {
            spacing: 8px;
            for c[i] in [
                { fill: #ff5f57, edge: #e2463f, glyph: "M8.5 8.5l7 7 M15.5 8.5l-7 7" },
                { fill: #febc2e, edge: #dea123, glyph: "M7.5 12h9" },
                { fill: #28c840, edge: #1aab29, glyph: "M8 8h5.5L8 13.5z M16 16h-5.5L16 10.5z" },
            ]: Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: c.fill;
                border-width: 0.5px;
                border-color: c.edge;
                Path {
                    viewbox-width: 24;
                    viewbox-height: 24;
                    width: 12px;
                    height: 12px;
                    commands: c.glyph;
                    stroke: #000000.with-alpha(0.55);
                    fill: i == 2 ? #000000.with-alpha(0.55) : transparent;
                    stroke-width: 1.4px;
                    stroke-line-cap: round;
                    opacity: root.show-glyphs ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }
                TouchArea {
                    clicked => {
                        if i == 0 { root.close(); } else if i == 1 { root.minimize(); } else { root.zoom(); }
                    }
                }
            }
        }
    }
}

// A floating glass card for sheets and empty states.
export component GlassCard inherits Rectangle {
    border-radius: 18px;
    background: Theme.sheet;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: 50px;
    drop-shadow-offset-y: 20px;
    drop-shadow-color: #000000.with-alpha(Theme.dark ? 0.5 : 0.18);
}

export component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
}
