// Small building blocks for Nava's glass interface.

export global Theme {
    in-out property <bool> dark: true;
    // 0 = calm, nearly solid surfaces; 1 = full, colourful glass.
    in-out property <float> glass: 0.8;
    in-out property <color> accent: #e0587b;
    // Brightness of the artwork's average colour, 0..1. Used to keep text readable.
    in-out property <float> mood-lum: 0.4;

    out property <color> base: dark ? #15131a : #f3f1f7;
    out property <color> fg: dark ? #f6f4f9 : #1b1a21;
    out property <color> muted: dark ? #f6f4f9.with-alpha(0.6) : #1b1a21.with-alpha(0.58);
    out property <color> faint: dark ? #ffffff.with-alpha(0.08) : #000000.with-alpha(0.06);
    out property <color> hover: dark ? #ffffff.with-alpha(0.10) : #000000.with-alpha(0.06);
    out property <color> hairline: dark ? #ffffff.with-alpha(0.10) : #ffffff.with-alpha(0.6);
    // Glass panels: thinner and clearer as `glass` goes up.
    out property <color> panel: dark ? #ffffff.with-alpha(0.045 + (1 - glass) * 0.05) : #ffffff.with-alpha(0.26 + (1 - glass) * 0.44);
    // Sheets float over busy content and there is no backdrop blur, so they stay nearly solid.
    out property <color> sheet: dark ? #221f29.with-alpha(0.97) : #fbfaff.with-alpha(0.97);
    // The veil over the blurred artwork. Never thinner than what keeps text readable.
    out property <float> veil: dark
        ? Math.max(0.9 - glass * 0.72, mood-lum * 0.5)
        : Math.max(0.9 - glass * 0.68, (1 - mood-lum) * 0.36);
    out property <color> on-accent: #ffffff;
    out property <color> danger: dark ? #ff6b6b : #d93636;
}

export global Icons {
    // Solid icons use sharp corners: tiny rounded corners blur or notch at small sizes.
    out property <string> play: "M8 5.2v13.6L19.2 12z";
    // Two bars with a wide gap, so they never merge into a square.
    out property <string> pause: "M6.4 5h3.6v14H6.4z M14 5h3.6v14H14z";
